# Copy to backend/.env and fill in. NEVER commit the real .env.
# If a key is committed by accident, rotate it immediately — removing the
# commit is not sufficient.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://mediagent:dev@localhost:5432/mediagent
TEST_DATABASE_URL=postgresql+psycopg://mediagent:dev@localhost:5433/mediagent_test

# --- auth -------------------------------------------------------------------
# Generate per environment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# --- model routing ----------------------------------------------------------
# Format: <provider>:<model>. See docs/LLM_PROVIDER_STRATEGY.md.
# Development default is local and free; only the critical tier costs money.
LLM_MECHANICAL=ollama:llama3.1:8b
LLM_CONVERSATIONAL=ollama:llama3.1:8b
LLM_CRITICAL=anthropic:claude-opus-5

ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- clinical data ----------------------------------------------------------
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_API_KEY=
